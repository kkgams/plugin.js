set(WASI_SDK_PREFIX "" CACHE PATH "Path to WASI SDK 30")
if(NOT WASI_SDK_PREFIX AND DEFINED ENV{WASI_SDK_PATH})
    set(WASI_SDK_PREFIX "$ENV{WASI_SDK_PATH}")
endif()
if(NOT EXISTS "${WASI_SDK_PREFIX}/share/cmake/wasi-sdk.cmake")
    message(FATAL_ERROR "WASI SDK 30 is required; use nix develop")
endif()
set(CMAKE_TOOLCHAIN_FILE "${WASI_SDK_PREFIX}/share/cmake/wasi-sdk.cmake")
